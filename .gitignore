# User-specific project context (don't commit local session files)
project.md
*.local.md

# Local project assessments (BTBA feedback, private client data)
projects/

# MCP configuration with user credentials
mcp/mcp-config.json

# Environment variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node/npm (if future MCP servers use Node)
node_modules/
package-lock.json

# Python (if future evaluation/analysis uses Python)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Temporary files
*.tmp
*.bak
.*.swp

# Logs
*.log

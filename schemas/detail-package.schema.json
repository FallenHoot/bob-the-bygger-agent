{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTBA advisory detail package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "revision", "basis", "status", "scope", "sources", "elements", "holds"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/text"},
    "basis": {"enum": ["synthetic", "project_advisory"]},
    "status": {"const": "draft_not_for_construction"},
    "scope": {"$ref": "#/$defs/text"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "location", "revision", "evidence_status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "location": {"$ref": "#/$defs/text"},
          "revision": {"$ref": "#/$defs/text"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evidence_status": {"enum": ["synthetic", "reported", "documented", "proposed", "unverified"]}
        }
      }
    },
    "elements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "location", "depends_on", "fields", "layers"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["wall", "opening", "well", "junction"]},
          "location": {"$ref": "#/$defs/text"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}},
          "layers": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["material", "thickness"],
              "properties": {"material": {"$ref": "#/$defs/text"}, "thickness": {"$ref": "#/$defs/quantity"}}
            }
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "elements", "reason", "reviewer", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "reason": {"$ref": "#/$defs/text"},
          "reviewer": {"$ref": "#/$defs/text"},
          "status": {"const": "open"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "quantity": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "status", "source_ids", "note"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["mm", "cm", "m"]},
        "status": {"enum": ["synthetic", "reported", "annotated", "measured", "proposed", "unknown"]},
        "datum": {"$ref": "#/$defs/text"},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "locator"],
            "properties": {
              "source_id": {"$ref": "#/$defs/id"},
              "locator": {"$ref": "#/$defs/text"},
              "page": {"type": "integer", "minimum": 1},
              "view": {"$ref": "#/$defs/text"}
            }
          }
        },
        "note": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"value": {"type": "null"}}}, "then": {"properties": {"status": {"const": "unknown"}}}},
        {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"value": {"type": "number"}}}, "then": {"properties": {"source_ids": {"minItems": 1}}}}
      ]
    }
  }
}